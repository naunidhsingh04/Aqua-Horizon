{
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/web/css/"
    },
    {
      "source": "/js/(.*)",
      "destination": "/web/js/"
    },
    {
      "source": "/data/(.*)",
      "destination": "/web/data/"
    }
  ]
}